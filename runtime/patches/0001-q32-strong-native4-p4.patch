+        y->ne[2] != 1 || y->ne[3] != 1 || !ggml_is_contiguous(w) ||
+        !ggml_is_contiguous(x) || !ggml_is_contiguous(y) || w->view_src) {
+        throw std::runtime_error("strong REF1 backend rejects descriptor; no fallback");
+    }
+}
